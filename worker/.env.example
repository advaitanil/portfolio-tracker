# Reference only — the Worker reads these as SECRETS, not from a .env file.
# For each one, run:  wrangler secret put NAME
# and paste the value when prompted. Never commit real values anywhere.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Project Settings > API — service_role, NOT anon
TWELVE_DATA_API_KEY=your-twelve-data-key
MARKETAUX_API_KEY=your-marketaux-key
ANTHROPIC_API_KEY=your-claude-api-key
RESEND_API_KEY=your-resend-key

# For local dev with `wrangler dev`, you can instead create worker/.dev.vars
# with these same KEY=value lines — .dev.vars is gitignored and wrangler
# loads it automatically. Still never commit it.
