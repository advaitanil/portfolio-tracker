# Never commit secrets — this is a hard rule of the assignment (Section 5/13).
.env
.dev.vars
worker/.dev.vars

# NOTE: public/config.js is intentionally NOT gitignored. It only holds the
# Supabase anon/publishable key, which is safe to expose in browser code by
# design (Row Level Security is what actually protects the data). It needs
# to be committed so Cloudflare Pages deploys it. Never put the
# service_role key here — that one stays a Worker secret only.

node_modules/
.wrangler/
.DS_Store
*.log
